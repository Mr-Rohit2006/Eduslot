# EduSlot Smart Class — Backend Environment Variables
# Copy this file as .env in the backend/ directory and fill in your values

# -----------------------------------------------
# MongoDB Connection URI
# -----------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/eduslot

# -----------------------------------------------
# JWT Secret Key (use a strong, random value)
# -----------------------------------------------
JWT_SECRET=eduslot_secret_key_change_this_in_production

# -----------------------------------------------
# SMTP Email Configuration (for student credential emails & password reset)
# Leave blank to fallback to console logging (dev mode)
# -----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rohitkumargoyal5555@gmail.com
SMTP_PASS=uleg jdwu lywr mzai
SMTP_FROM="EduSlot Admin <no-reply@eduslot.com>"

# -----------------------------------------------
# Server Port
# -----------------------------------------------
PORT=5000
